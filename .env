# API configuration for the MrAndreID/goapi service.
# The goapi runs on port 10001 by default and exposes routes under /api/v1.
#
# Android emulator: use 10.0.2.2 to reach the host machine.
# iOS simulator:    use 127.0.0.1 (localhost).
# Physical device:  use your machine's LAN IP, e.g. http://192.168.1.10:10001
API_BASE_URL=http://10.0.2.2:10001

# goapi protects /api routes with an application key (EchoCheckApplicationKey).
# Set this to the APP_KEY value configured in the goapi .env file.
API_APP_KEY=XDd9P96sD8NhyFSXDHtGhr2v4whF7jFF
