<?xml version="1.0" encoding="utf-8"?>
<!--
  Konfigurasi keamanan jaringan.

  Secara default cleartext (HTTP) DILARANG. Cleartext hanya diizinkan untuk
  host goapi lokal saat pengembangan:
    - 10.0.2.2   : host machine dari Android emulator
    - 127.0.0.1  : loopback
    - localhost

  Untuk produksi, gunakan HTTPS dan JANGAN menambahkan domain publik ke
  daftar cleartext di bawah.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
