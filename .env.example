# Template konfigurasi untuk layanan MrAndreID/goapi.
# Salin file ini menjadi `.env` lalu isi nilainya:
#   cp .env.example .env
#
# goapi berjalan di port 10001 secara default dan mengekspos rute di /api/v1.
#
# Android emulator: gunakan 10.0.2.2 untuk mencapai mesin host.
# iOS simulator:    gunakan 127.0.0.1 (localhost).
# Perangkat fisik:  gunakan IP LAN mesin, mis. http://192.168.1.10:10001
API_BASE_URL=http://10.0.2.2:10001

# goapi melindungi rute /api dengan application key (EchoCheckApplicationKey).
# Set nilai ini agar cocok dengan APP_KEY di file .env goapi.
API_APP_KEY=your-goapi-app-key

# Timeout koneksi & terima (detik) untuk request HTTP. Opsional; default 15.
API_TIMEOUT_SECONDS=15
